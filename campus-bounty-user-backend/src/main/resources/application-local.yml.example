# 复制为 application-local.yml 后填写真实值，并以 local profile 启动。
# application-local.yml 已被 .gitignore 忽略，请勿提交真实数据库密码或 JWT 密钥。
spring:
  datasource:
    url: jdbc:mysql://<数据库主机>:<端口>/campus_bounty?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: <数据库用户名>
    password: <数据库密码>
jwt:
  secret: <替换为至少32字节的随机JWT密钥>
